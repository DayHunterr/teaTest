{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ encore_entry_link_tags('articles') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('articles') }}
{% endblock %}

{% block body %}
    <section class="main-blog">
        <div class="container">
            <h2 class="title main-blog__title">{{ article.title }}</h2>
            <ul class="main-blog__list">
                    <li class="main-blog__item">
                        <img class="main-blog__item-img" src="{{ asset('build/images/tea-on-table.png') }}" alt="Article Image">
                        <div class="main-blog__item-content">
                            <h3 class="main-blog__item-title">{{ article.title }}</h3>
                            <a class="main-blog__item-author" href="#">{{ article.author }}</a>
                            <p class="main-blog__item-author" href="#">{{ article.text | raw }}</p>
                        </div>
                    </li>
                <li><a href="{{ path('articles') }}">← Back to List</a></li>
            </ul>
        </div>
    </section>
{% endblock body %}

{% block ld_json %}
{% endblock ld_json %}
