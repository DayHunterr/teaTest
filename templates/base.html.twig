<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'title'|trans }}{% endblock title %}</title>

    {% block meta %}
    {% endblock meta %}

    {% block fonts %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
              rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400..700;1,300..700&fam ily=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
              rel="stylesheet">
    {% endblock fonts %}

    {% block stylesheets %}{% endblock stylesheets %}
    {% block javascripts %}{% endblock javascripts %}

    {% block mob_menu %}
        <header class="header" data-controller="menu">
            <div class="menu--close" data-menu-target="shadow"></div>
            <div class="container">
                <div class="header__inner">
                    <a class="logo" href="{{ path('home') }}">
                        <img src="{{ asset('build/images/logo.svg') }}" alt="TealuxE">
                    </a>
                    <nav class="menu">
                        <button class="menu__btn" data-menu-target="btn">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                        </button>
                        <ul class="menu__list" data-menu-target="list">
                            <li class="menu__close">
                                <button class="menu__close-btn" data-menu-target="close">
                                    <img src="{{ asset('build/images/close.svg') }}" alt="Close cross">
                                </button>
                            </li>
                            <li class="menu__item">
                                <a class="menu__link" href="#">{{ 'black'|trans }}</a>
                            </li>
                            <li class="menu__item">
                                <a class="menu__link" href="#">{{ 'green'|trans }}</a>
                            </li>
                            <li class="menu__item">
                                <a class="menu__link" href="#">{{ 'white'|trans }}</a>
                            </li>
                            <li class="menu__item">
                                <a class="menu__link" href="#">{{ 'oolong'|trans }}</a>
                            </li>
                            <li class="menu__item">
                                <a class="menu__link" href="#">{{ 'pu-erh'|trans }}</a>
                            </li>
                            <li class="mobile-nav">
                                <ul class="mobile-menu">
                                    <li class="mobile-menu__item">
                                        <a class="mobile__menu-link" href="#">{{ 'contact_us'|trans }}s</a>
                                    </li>
                                    <li class="mobile-menu__item">
                                        <a class="mobile__menu-link" href="#">{{ 'our_blog'|trans }}</a>
                                    </li>
                                    <li class="mobile-menu__item">
                                        <a class="mobile__menu-link" href="#">{{ 'shipping_and_delivery'|trans }}</a>
                                    </li>
                                </ul>
                                <ul class="mobile-actions">
                                    <li class="mobile-actions__item">
                                        <a class="user-actions__link" href="#">
                                            <img src="{{ asset('build/images/icon-cart.svg') }}" alt="Cart">
                                        </a>
                                    </li>
                                    <li class="mobile-actions__item">
                                        <a class="user-actions__link" href="#">
                                            <img src="{{ asset('build/images/icon-user.png') }}" alt="User Profile">
                                        </a>
                                    </li>
                                    <li class="mobile-actions__item">
                                        <a class="user-actions__link" href="#">
                                            <img src="{{ asset('build/images/icon-search.svg') }}" alt="Search">
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </nav>
                    <ul class="user-actions">
                        <li class="user-actions__item">
                            <a class="user-actions__link" href="#">
                                <img src="{{ asset('build/images/icon-cart.svg') }}" alt="Cart">
                            </a>
                        </li>
                        <li class="user-actions__item">
                            <a class="user-actions__link" href="#">
                                <img src="{{ asset('build/images/icon-user.png') }}" alt="User Profile">
                            </a>
                        </li>
                        <li class="user-actions__item user-actions__item-search">
                            <a class="user-actions__link" href="#">
                                <img src="{{ asset('build/images/icon-search.svg') }}" alt="Search">
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
    {% endblock mob_menu %}

    {% block ld_json %}
    {% endblock ld_json %}

{% block body %}{% endblock body %}