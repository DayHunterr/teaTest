{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ encore_entry_link_tags('homepage') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('homepage') }}
{% endblock %}

{% block body %}
<div class="wrapper">
    <main class="main">
        <section class="top">
            <div class="container">
                <div class="top_inner">
                    <h1 class="top__title">
                        {{ 'main.title'|trans }}
                    </h1>
                    <p class="top__text">
                        {{ 'main.subtitle'|trans }}
                    </p>
                </div>
            </div>
        </section>
        <blockquote class="blockquote">
            <p class="blockquote__text">
                {{ 'blockquote.text'|trans }}<span class="highlight">{{ 'blockquote.text.highlight'|trans }}</span>
            </p>
        </blockquote>
        <section class="assortment">
            <div class="container">
                <h2 class="title assortment__title">{{ 'assortment.title'|trans }}</h2>
                <ul class="assortment__list">
                    <li class="assortment__item">
                        <img class="assortment__img" src="{{ asset('build/images/black-tea.png') }}" alt="Black Tea">
                        <p class="assortment__name">{{ 'assortment.black_tea'|trans }}</p>
                    </li>
                    <li class="assortment__item">
                        <img class="assortment__img" src="{{ asset('build/images/green-tea.png') }}" alt="Green Tea">
                        <p class="assortment__name">{{ 'assortment.green_tea'|trans }}</p>
                    </li>
                    <li class="assortment__item">
                        <img class="assortment__img" src="{{ asset('build/images/white-tea.png') }}" alt="White Tea">
                        <p class="assortment__name">{{ 'assortment.white_tea'|trans }}</p>
                    </li>
                    <li class="assortment__item">
                        <img class="assortment__img" src="{{ asset('build/images/oolong-tea.png') }}" alt="Oolong Tea">
                        <p class="assortment__name">{{ 'assortment.oolong_tea'|trans }}</p>
                    </li>
                    <li class="assortment__item">
                        <img class="assortment__img" src="{{ asset('build/images/puerh-tea.png') }}" alt="Pu-erh Tea">
                        <p class="assortment__name">{{ 'assortment.puerh_tea'|trans }}</p>
                    </li>
                </ul>
            </div>
        </section>
        <section class="reviews">
            <div class="container">
                <h2 class="title">{{ 'reviews.title'|trans }}</h2>
                <ul class="reviews__list">

                    <li class="reviews__item">
                        <blockquote>
                            <p class="reviews__text">
                                {{ 'reviews.1.text'|trans }}
                            </p>
                            <cite class="reviews__name">{{ 'reviews.1.author'|trans }}</cite>
                        </blockquote>
                    </li>
                    <li class="reviews__item">
                        <blockquote>
                            <p class="reviews__text">{{ 'reviews.2.text'|trans }}</p>
                            <cite class="reviews__name">{{ 'reviews.2.author'|trans }}</cite>
                        </blockquote>
                    </li>
                    <li class="reviews__item">
                        <blockquote>
                            <p class="reviews__text">{{ 'reviews.3.text'|trans }}"</p>
                            <cite class="reviews__name">{{ 'reviews.3.author'|trans }}</cite>
                        </blockquote>
                    </li>
                    <li class="reviews__item">
                        <blockquote>
                            <p class="reviews__text">{{ 'reviews.4.text'|trans }}</p>
                            <cite class="reviews__name">{{ 'reviews.4.author'|trans }}</cite>
                        </blockquote>
                    </li>
                </ul>
            </div>
        </section>
        <section class="main-blog">
            <div class="container">
                <h2 class="title main-blog__title">{{ 'blog.title'|trans }}</h2>
                <ul class="main-blog__list">
                    {% for article in latestArticles %}
                        <li class="main-blog__item">
                            {% if article.smallImage %}
                                <img class="main-blog__item-img" src="{{ asset(article.smallImage) }}" alt="{{ article.title }}">
                            {% else %}
                                <img class="main-blog__item-img" src="{{ asset('build/images/tea-on-table.png') }}" alt="Default image">
                            {% endif %}
                            <div class="main-blog__item-content">
                                <h3 class="main-blog__item-title">
                                    <a href="{{ path('article', { id: article.id }) }}">{{ article.title }}</a>
                                </h3>
                                <a class="main-blog__item-author" href="#">{{ article.author }}</a>
                                <a class="main-blog__item-link" href="{{ path('article', { id: article.id }) }}">{{ 'blog.post.read'|trans }}</a>
                            </div>
                        </li>
                    {% else %}
                        <li class="main-blog__item-empty">{{ 'blog.post.empty'|trans }}</li>
                    {% endfor %}
                </ul>
                <a class="main-blog__link" href="{{ path('articles') }}">{{ 'blog.view_all'|trans }}</a>
            </div>
        </section>

        {{ render(controller('App\\Controller\\MailingController::renderQuestionForm')) }}

        <section class="prioritize">
            <div class="container">
                <h2 class="title prioritize__title">{{ 'prioritize.title'|trans }}</h2>
                <ul class="prioritize__list">
                    <li class="prioritize__item">
                        <h4 class="prioritize__item-title">{{ 'prioritize.1.title'|trans }}</h4>
                        <p class="prioritize__text">{{ 'prioritize.1.text'|trans }}</p>
                        <img class="prioritize__img" src="{{ asset('build/images/earth.png') }}" alt="Earth">
                    </li>
                    <li class="prioritize__item">
                        <h4 class="prioritize__item-title">{{ 'prioritize.2.title'|trans }}</h4>
                        <p class="prioritize__text">{{ 'prioritize.2.text'|trans }}</p>
                        <img class="prioritize__img" src="{{ asset('build/images/leafes.png') }}" alt="Leafes">
                    </li>
                    <li class="prioritize__item">
                        <h4 class="prioritize__item-title">{{ 'prioritize.3.title'|trans }}</h4>
                        <p class="prioritize__text">{{ 'prioritize.3.text'|trans }}</p>
                        <img class="prioritize__img" src="{{ asset('build/images/headphones.png') }}" alt="Headphones">
                    </li>
                    <li class="prioritize__item">
                        <h4 class="prioritize__item-title">{{ 'prioritize.4.title'|trans }}</h4>
                        <p class="prioritize__text">{{ 'prioritize.4.text'|trans }}</p>
                        <img class="prioritize__img" src="{{ asset('build/images/box.png') }}" alt="Fast Shipping Icon">
                    </li>
                </ul>

            </div>
        </section>
    </main>
    <footer class="footer">
        <div class="container">
            <div class="footer__inner">
                <ul class="footer__products">
                    <li class="footer__products-title">{{ 'footer.products.title'|trans }}</li>
                    <li class="footer__products-item">
                        <a class="footer__products-link" href="#">{{ 'footer.products.black'|trans }}</a>
                    </li>
                    <li class="footer__products-item">
                        <a class="footer__products-link" href="#">{{ 'footer.products.green'|trans }}</a>
                    </li>
                    <li class="footer__products-item">
                        <a class="footer__products-link" href="#">{{ 'footer.products.white'|trans }}</a>
                    </li>
                    <li class="footer__products-item">
                        <a class="footer__products-link" href="#">{{ 'footer.products.oolong'|trans }}</a>
                    </li>
                    <li class="footer__products-item">
                        <a class="footer__products-link" href="#">{{ 'footer.products.puerh'|trans }}</a>
                    </li>
                </ul>
                <ul class="footer__company">
                    <li class="footer__company-title">{{ 'footer.company.title'|trans }}</li>
                    <li class="footer__company-item">
                        <a class="footer__company-link" href="#">{{ 'footer.company.about'|trans }}s</a>
                    </li>
                    <li class="footer__company-item">
                        <a class="footer__company-link" href="#">{{ 'footer.company.contact'|trans }}s</a>
                    </li>
                    <li class="footer__company-item">
                        <a class="footer__company-link" href="#">{{ 'footer.company.blog'|trans }}</a>
                    </li>
                    <li class="footer__company-item">
                        <a class="footer__company-link" href="#">{{ 'footer.company.faq'|trans }}</a>
                    </li>
                    <li class="footer__company-item">
                        <a class="footer__company-link" href="#">{{ 'footer.company.shipping'|trans }}</a>
                    </li>
                    <li class="footer__company-item">
                        <a class="footer__company-link" href="#">{{ 'footer.company.refund'|trans }}</a>
                    </li>
                    <li class="footer__company-item">
                        <a class="footer__company-link" href="#">{{ 'footer.company.terms'|trans }}</a>
                    </li>
                </ul>
                <blockquote class="footer__blockquote">
                    <p class="footer__blockquote-text">{{ 'footer.blockquote.title'|trans }}</p>
                    <cite class="footer__blockquote-author">{{ 'footer.blockquote.author'|trans }} <span>{{ 'teaLuxe_owner'|trans }}</span></cite>
                </blockquote>
                <div class="footer__contacts">
                    <h5 class="footer__contacts-title">{{ 'stay_in_touch'|trans }}</h5>
                    <p class="footer__contacts-text">{{ 'please_feel_free'|trans }}</p>
                    <ul class="footer__nav">
                        <li class="footer__nav-logo">
                            <a class="footer__logo" href="#">
                                <img src="{{ asset('build/images/tea-footer.png') }}" alt="Tea in footer">
                            </a>
                        </li>
                        <li class="footer__nav-contacts">
                            <a class="footer__nav-phone" href="tel:+370 698 123456">{{ 'phone'|trans }}</a>
                            <a class="footer__nav-email" href="mailto::info@tealuxe.com">{{ 'email'|trans }}</a>
                        </li>
                        <li class="footer__social">
                            <ul class="footer__social-list">
                                <li class="footer__social-item">
                                    <a class="footer__social-link" href="#">
                                        <img src="{{ asset('build/images/facebook.png') }}" alt="Facebook">
                                    </a>
                                </li>
                                <li class="footer__social-item">
                                    <a class="footer__social-link" href="#">
                                        <img src="{{ asset('build/images/youtube.png') }}" alt="YouTube">
                                    </a>
                                </li>
                                <li class="footer__social-item">
                                    <a class="footer__social-link" href="#">
                                        <img src="{{ asset('build/images/instagram.png') }}" alt="Instagram">
                                    </a>
                                </li>
                                <li class="footer__social-item">
                                    <a class="footer__social-link" href="#">
                                        <img src="{{ asset('build/images/twitter.png') }}" alt="Twitter">
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="footer__bottom">
                <p class="footer__copy">{{ 'tea_luxe_2023'|trans }}</p>
                <ul class="partners-logo">
                    <li class="partners-logo__item">
                        <img src="{{ asset('build/images/icon-visa.png') }}" alt="Visa">
                    </li>
                    <li class="partners-logo__item">
                        <img src="{{ asset('build/images/icon-mastercard.png') }}" alt="MasterCard">
                    </li>
                    <li class="partners-logo__item">
                        <img src="{{ asset('build/images/icon-google-pay.png') }}" alt="GooglePay">
                    </li>
                    <li class="partners-logo__item">
                        <img src="{{ asset('build/images/icon-paypal.png') }}" alt="PayPal">
                    </li>
                </ul>
            </div>
        </div>
    </footer>
</div>
{% endblock body %}

{% block ld_json %}
{% endblock ld_json %}
