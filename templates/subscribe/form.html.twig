<section class="mailing-list">
    <div class="container">
        <h2 class="title mailing-list__title">{{ 'mailing.title'|trans }}</h2>
        <div class="mailing-list__inner">
            <p class="mailing-list__text">{{ 'mailing.text'|trans }}</p>

            {{ form_start(form, {
                action: path('mailing_subscribe'),
                attr: {
                    class: 'mailing-list__form',
                    'data-controller': 'mailing',
                    'data-action': 'submit->mailing#submit',
                    'data-mailing-target': 'form'
                }
            }) }}

            {{ form_row(form.email) }}

            {{ form_widget(form.submit) }}

            <label class="mailing-list__label">
                {{ form_widget(form.agree, {'attr': {'class': 'checkbox'}}) }}
                <span class="checkbox-style"></span>
                <p class="checkbox__text">{{ 'mailing.privacy'|trans }}</p>
            </label>
            <div data-mailing-target="message" class="mailing-list__message"></div>
            {{ form_end(form, {'render_rest': false}) }}
        </div>
    </div>
</section>